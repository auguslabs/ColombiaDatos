# Gemini API Key for server-side calls
GEMINI_API_KEY=

# Firebase configuration parameters for external environments (e.g., QA / Production)
# Leave empty on development to fallback automatically to AI Studio sandbox credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
